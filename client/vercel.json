{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.devmemory.xyz/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://api.devmemory.xyz/socket.io/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}